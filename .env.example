# ============================================================
#  .env.example —— 配置模板（这个文件可以进版本库）
# ============================================================
#  用法：cp .env.example .env  然后填上你自己的值
#
#  【为什么要有这个文件】
#    .env 装的是你的真实密钥（API key、邮箱授权码）—— 绝不能进版本库
#    .env.example 装的是【变量名和说明】，不含任何真实值 —— 可以进库
#    别人 clone 下来照着这个填，就知道该配什么
# ============================================================


# ===== 当前使用哪家厂商 =====
# id 见 src/config.ts 的 BUILTIN_PROVIDERS（local / openai / deepseek / glm / moonshot / qwen）
# 也可以是 data/providers.json 里自定义的 id。
LLM_PROVIDER=local


# ===== 各家厂商分别配 =====
# 命名规则：LLM_<大写ID>_<字段>
# 填了 key 就多出一个可选项，不填就显示"缺 API key"（不影响启动）。

# --- 本机网关（Claude Code 用的那个，默认 127.0.0.1:8787）---
LLM_LOCAL_BASE_URL=http://127.0.0.1:8787/v1
LLM_LOCAL_API_KEY=local-gateway
LLM_LOCAL_MODEL=GLM-5.3
# system 送达方式：inline（放 messages 里）/ top（放顶层）/ both
# 大多数厂商用 inline；Anthropic 原生网关用 top。
LLM_LOCAL_SYSTEM_DELIVERY=top

# --- OpenAI ---
#LLM_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
#LLM_OPENAI_MODEL=gpt-4o-mini

# --- DeepSeek（国内直连，不用代理）---
#LLM_DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
#LLM_DEEPSEEK_MODEL=deepseek-chat

# --- 智谱 GLM（有免费模型 glm-4-flash，调试期最省心）---
#LLM_GLM_API_KEY=xxxxxxxx.xxxxxxxx
#LLM_GLM_MODEL=glm-4-flash

# --- Moonshot / Kimi ---
#LLM_MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxx
#LLM_MOONSHOT_MODEL=moonshot-v1-8k

# --- 阿里通义千问 ---
#LLM_QWEN_API_KEY=sk-xxxxxxxxxxxxxxxx
#LLM_QWEN_MODEL=qwen-plus

# --- 中转站（任何 OpenAI 兼容接口）---
# 变量名用你自己的 id，全大写。比如 id 是 mygw → LLM_MYGW_API_KEY
#LLM_RELAY_BASE_URL=https://your-relay.example/v1
#LLM_RELAY_API_KEY=sk-xxxxxxxxxxxxxxxx
#LLM_RELAY_MODEL=gpt-4o-mini


# ===== 自定义厂商（可选）=====
# 写在 data/providers.json 里（结构化配置），密钥照样放 .env：
#   { "mygw": { "label": "公司网关", "baseUrl": "https://gw.corp/v1", "model": "xxx" } }
# 然后在 .env 里加一行：LLM_MYGW_API_KEY=xxxx


# ===== 预算护栏 =====
# 记账花费达到这个数（美元）就拒绝新的真实调用，防止写坏的循环烧光额度。
# <= 0 表示不限（本地调试可以用它关掉护栏）。
MAIL_BUDGET_USD=2.0

# 单次 HTTP 请求超时（毫秒）
LLM_TIMEOUT_MS=120000

# 单次调用的上下文上限（token），超过就先压缩再发
MAIL_CONTEXT_BUDGET=12000

# ReAct 循环最多几轮
MAIL_MAX_TURNS=15

# Agent 模式：confirm（副作用工具先审批）/ auto（直接执行）
MAIL_MODE=confirm

# Agent 额外护栏（可选）：命中这些子串的【工具调用】会被直接拒绝，连审批都不弹。
# 纯文本子串（不是正则），多条用 || 分隔。默认空即可 —— 发信已被审批把关。
# 例：MAIL_AGENT_DENY=forward||external-transfer
MAIL_AGENT_DENY=

# TLS 证书校验（可选）：默认校验（安全）。仅当邮箱服务器用自签证书时才设为 0 放宽。
# MAIL_TLS_REJECT_UNAUTHORIZED=0

# 邮件按天分组用的时区（必须是本地时区，不能用 UTC）
MAIL_TIMEZONE=Asia/Shanghai


# ===== 邮箱（实时抓取，可选）=====
# 不填也能跑 —— 只是没法拉真实邮件。
# 服务商 id：qq / exmail / outlook / gmail / 163 / 126 / custom
# host/port/secure 会按 id 自动取，不用手填。
MAIL_IMAP_PROVIDER=qq

# 登录账号（一般是完整邮箱地址）
MAIL_IMAP_USER=

# 授权码 / 应用专用密码
# ⚠️ 不是登录密码！QQ 要去「设置 → 账户 → POP3/IMAP/SMTP」开启后生成授权码
MAIL_IMAP_PASS=

# 要打开的邮箱夹，默认 INBOX
MAIL_IMAP_MAILBOX=INBOX

# 自定义服务器时才需要（MAIL_IMAP_PROVIDER=custom）
#MAIL_IMAP_HOST=
#MAIL_IMAP_PORT=993
#MAIL_IMAP_SECURE=true

# ===== 通知时限（monitor）=====
# 【两个不同的时限，别混】
# ① 弹窗显示时长：弹窗在屏幕上停留多久后自动消失（毫秒，默认 10000 = 10 秒）
MAIL_POPUP_TTL_MS=10000
# ② 降级时限：弹窗后多久没人处理，就不再打扰、只进摘要（毫秒，默认 1800000 = 30 分钟）
MAIL_ESCALATE_AFTER_MS=1800000
# ③ 冷却期：两次弹窗之间至少隔多久（毫秒，默认 300000 = 5 分钟）—— 防刷屏
MAIL_NOTIFY_COOLDOWN_MS=300000
# ④ 同一封邮件最多弹几次（默认 1 = 每封信只提醒一次）
#    弹过一次就记住；用户没处理的话，弹窗 TTL 到了就消失，
#    之后这封信只进摘要，不再打扰。
MAIL_NOTIFY_MAX_REPEAT=1

# ===== 数字人形象（Web UI 里选，自动写回这里）=====
# 为什么存在 .env 而不是浏览器本地存储：
#   localStorage 只属于"这个浏览器、这台机器"，清缓存/换浏览器就没了。
#   "我喜欢哪个数字人形象"是长期偏好，该跟其它配置放在一起。
MAIL_AVATAR_KEY=bot
MAIL_AVATAR_COLOR=blue
# 选中的视频文件名（放在「数字人视频」目录下）；留空 = 用内置预设形象
MAIL_AVATAR_VIDEO=

# ===== 界面偏好 =====
# 主题：light / dark
MAIL_UI_THEME=
# 天气/出行卡片用的默认城市
MAIL_UI_WEATHER_CITY=

# 上传视频的说明：
#   用户在界面上「选择视频文件」时，文件会被真正上传到「数字人视频」目录，
#   然后写进 MAIL_AVATAR_VIDEO。刷新/换浏览器都还在。
#   手动放文件也行：把 mp4/webm/mov 丢进「数字人视频」目录，再点「重新扫描」。

# ===== 语音转文字（可选，本地 whisper，离线免费）=====
# macOS 系统语音识别用临时签名会被系统卡住，推荐用本地 whisper.cpp。
# 需先安装（见 docs/项目结构与代码说明.html 的语音章节）：
#   cmake + whisper.cpp 编译出 whisper-cli，下载 ggml 模型到 .voice-local/models/。
# 下面的 bin 是自带的格式转换包装器（m4a/aiff → wav），路径相对项目根。
# 不填这两行也能跑，只是语音输入不可用、需手动打字。
MAIL_STT_WHISPER_BIN=.voice-local/whisper-cli-wrap.py
MAIL_STT_WHISPER_MODEL=.voice-local/models/ggml-small.bin

# ===== 文字转语音（TTS）：朗读音色（可选）=====
# 默认用本地 piper 神经音色（离线、比系统 say 流畅自然）。需先安装：
#   bash scripts/setup-voice.sh      # 自动装 piper + 中文识别/合成模型
#
# 【为什么 bin 指向 piper-wrap.py 而不是 piper】
#   piper 的中文分句不认标点，实测一整段「你好，我是助手。今天有三封邮件。」
#   会一口气念完、中间零停顿，听感很糊。scripts/piper-wrap.py 按标点切句、
#   逐句合成再插回 0.22/0.45 秒停顿，同样的文本能听出断句。
# 停顿想更明显：加环境变量 PIPER_SENTENCE_PAUSE=0.6、PIPER_COMMA_PAUSE=0.3
# 换声音：保留 piper 改 PIPER_MODEL 指向别的模型；或把 BACKEND 改 say 用自带的 VOICE。
MAIL_TTS_BACKEND=piper
MAIL_TTS_PIPER_BIN=scripts/piper-wrap.py
MAIL_TTS_PIPER_MODEL=.voice-local/models/zh_CN-huayan-medium.onnx
MAIL_TTS_VOICE=Tingting
